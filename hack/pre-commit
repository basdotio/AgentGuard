#!/usr/bin/env bash
# AgentGuard pre-commit gate.
# Install:  cp hack/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Blocks a commit if any staged skill/agent artifact scans at or above the threshold.
# Scans each staged directory that contains a SKILL.md (a skill being added/edited).
set -euo pipefail

AGUARD="${AGUARD:-aguard}"
FAIL_ON="${AGUARD_FAIL_ON:-high}"

# Proposal / issue bookkeeping (process.md §5, §6): state vocabulary and evidence lines.
# Runs first and independently of aguard being installed.
"$(git rev-parse --show-toplevel)/hack/check-proposal"

# Staged skill dirs (dirs whose SKILL.md is staged). Bash 3 compatible: macOS ships 3.2, which
# has no mapfile — the previous form died there with "mapfile: command not found".
skills=()
while IFS= read -r d; do
  [ -n "$d" ] && skills+=("$d")
done < <(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)SKILL\.md$' | xargs -n1 dirname 2>/dev/null | sort -u)

if [ "${#skills[@]}" -eq 0 ]; then
  exit 0
fi

status=0
for dir in "${skills[@]}"; do
  echo "AgentGuard: checking $dir"
  if ! "$AGUARD" check "$dir" --fail-on "$FAIL_ON" --quiet; then
    echo "  ✗ $dir failed AgentGuard gate (>= $FAIL_ON). Run: $AGUARD check $dir" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "Commit blocked by AgentGuard. Fix findings, or set AGUARD_FAIL_ON=critical to relax." >&2
fi
exit "$status"
