#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# BAS Guard pre-commit gate.
# Install:  cp hack/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Blocks a commit if any staged skill/agent artifact scans at or above the threshold.
# Scans each staged directory that contains a SKILL.md (a skill being added/edited).
set -euo pipefail

# BAS_GUARD_FAIL_ON is the name since the rename to BAS Guard (P-082) and wins; AGUARD_FAIL_ON
# still works.
# The binary is bas-guard since the rename (P-082); an install from before it has only aguard.
AGUARD="${AGUARD:-$(command -v bas-guard >/dev/null 2>&1 && echo bas-guard || echo aguard)}"
FAIL_ON="${BAS_GUARD_FAIL_ON:-${AGUARD_FAIL_ON:-high}}"

# Staged skill dirs (dirs whose SKILL.md is staged). Bash 3 compatible: macOS ships 3.2, which
# has no mapfile — the previous form died there with "mapfile: command not found".
skills=()
while IFS= read -r d; do
  [ -n "$d" ] && skills+=("$d")
done < <(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)SKILL\.md$' | xargs -n1 dirname 2>/dev/null | sort -u)

if [ "${#skills[@]}" -eq 0 ]; then
  exit 0
fi

status=0
for dir in "${skills[@]}"; do
  echo "BAS Guard: checking $dir"
  if ! "$AGUARD" check "$dir" --fail-on "$FAIL_ON" --quiet; then
    echo "  ✗ $dir failed the BAS Guard gate (>= $FAIL_ON). Run: $AGUARD check $dir" >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "Commit blocked by BAS Guard. Fix findings, or set BAS_GUARD_FAIL_ON=critical to relax." >&2
fi
exit "$status"
