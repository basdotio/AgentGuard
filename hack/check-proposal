#!/usr/bin/env bash
# check-proposal (process.md §5, §6): called from hack/pre-commit; also runnable by hand.
#
# For every staged docs/proposals/**/*.md and issues/*.md (index and template excluded):
#   1. a proposal must live in one of the four state directories — draft/ design/ complete/
#      rejected/ — and must not carry a `状态:` line: the directory is the one source of truth,
#      and a second copy of the state is exactly what drifted twice before (process.md §5);
#   2. a proposal staged under complete/, or an issue whose staged lines set the state to
#      已修复 / 部分修复, must carry a line beginning with 证据: — the evidence line §6 requires.
# Only newly added lines trigger the issue half of rule 2: history is not re-judged.
#
# Bash 3 compatible on purpose (macOS ships 3.2): no mapfile, no associative arrays.
set -euo pipefail

status=0

while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$(basename "$f")" in README.md|TEMPLATE.md) continue ;; esac

  staged="$(git show ":$f")"
  added="$(git diff --cached -U0 -- "$f" | grep -E '^\+[^+]' | sed 's/^+//' || true)"
  has_evidence=0
  if printf '%s\n' "$staged" | grep -qE '^[[:space:]]*(\*\*)?证据(\*\*)?(:|：)'; then has_evidence=1; fi

  case "$f" in
    docs/proposals/draft/*|docs/proposals/design/*|docs/proposals/complete/*|docs/proposals/rejected/*)
      if printf '%s\n' "$staged" | grep -qE '^- \*\*状态\*\*'; then
        echo "check-proposal: $f: proposals carry no 状态: line — the directory is the state (process.md §5)" >&2
        status=1
      fi
      case "$f" in docs/proposals/complete/*)
        if [ "$has_evidence" -eq 0 ]; then
          echo "check-proposal: $f: is staged under complete/ but has no '证据:' line (process.md §6)" >&2
          status=1
        fi
      esac
      ;;
    docs/proposals/*)
      echo "check-proposal: $f: a proposal must be in draft/, design/, complete/ or rejected/ — the directory is the state (process.md §5)" >&2
      status=1
      ;;
    issues/*)
      if printf '%s\n' "$added" | grep -qE '状态.*(已修复|部分修复)' && [ "$has_evidence" -eq 0 ]; then
        echo "check-proposal: $f: a staged line sets the state to 已修复/部分修复, but the file has no '证据:' line (process.md §6)" >&2
        status=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -- 'docs/proposals/*.md' 'docs/proposals/*/*.md' 'issues/*.md')

exit "$status"
